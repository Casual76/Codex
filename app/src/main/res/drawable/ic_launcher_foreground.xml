<?xml version="1.0" encoding="utf-8"?>
<!-- Il geode: un cristallo esagonale di ametista sfaccettato, con la runa Kaunan (ᚲ, "la torcia")
     incisa e luminosa. Tutto dentro il cerchio sicuro di 66 dp centrato in (54, 54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
  android:width="108dp"
  android:height="108dp"
  android:viewportWidth="108"
  android:viewportHeight="108">

  <!-- Alone dietro il cristallo. -->
  <path
    android:fillColor="#26C9A6FF"
    android:pathData="M54,20 L84,38 L84,70 L54,88 L24,70 L24,38 Z" />

  <!-- Le sei facce, dal vertice centrale: la luce arriva dall'alto a sinistra. -->
  <path
    android:fillColor="#FF8E63D9"
    android:pathData="M54,27 L31,40 L54,54 Z" />
  <path
    android:fillColor="#FFA987EA"
    android:pathData="M54,27 L77,40 L54,54 Z" />
  <path
    android:fillColor="#FF6A3FBF"
    android:pathData="M31,40 L31,68 L54,54 Z" />
  <path
    android:fillColor="#FF7E52D1"
    android:pathData="M77,40 L77,68 L54,54 Z" />
  <path
    android:fillColor="#FF4A2A8A"
    android:pathData="M31,68 L54,81 L54,54 Z" />
  <path
    android:fillColor="#FF5E35A8"
    android:pathData="M54,81 L77,68 L54,54 Z" />

  <!-- Riflesso speculare sulla faccia in luce. -->
  <path
    android:fillColor="#40FFFFFF"
    android:pathData="M54,27 L40,35 L50,41 Z" />

  <!-- Bordo del cristallo, sottile. -->
  <path
    android:strokeColor="#66EADCFF"
    android:strokeWidth="1"
    android:fillColor="#00000000"
    android:pathData="M54,27 L77,40 L77,68 L54,81 L31,68 L31,40 Z" />

  <!-- La runa: bagliore largo sotto e tratto netto sopra. -->
  <path
    android:strokeColor="#66EADCFF"
    android:strokeWidth="7"
    android:strokeLineCap="round"
    android:strokeLineJoin="round"
    android:fillColor="#00000000"
    android:pathData="M60,42 L48,54 L60,66" />
  <path
    android:strokeColor="#FFF4EEFF"
    android:strokeWidth="3.2"
    android:strokeLineCap="round"
    android:strokeLineJoin="round"
    android:fillColor="#00000000"
    android:pathData="M60,42 L48,54 L60,66" />
</vector>
