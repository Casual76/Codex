<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Compose disegna tutto; il tema di piattaforma deve solo togliersi di mezzo e lasciare la
       finestra da bordo a bordo, cosi' le barre hanno qualcosa su cui stare. Il colore delle icone
       di stato lo decide la MainActivity in base al tema risolto (scuro di default). -->
  <style name="Theme.Codex" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/codex_window_background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>
</resources>
