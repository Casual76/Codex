<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo per le build di lavoro.

  Il manifest principale dice `usesCleartextTraffic="false"`, ed e' giusto che lo dica: Codex non
  ha nessuna ragione di parlare in chiaro con qualcuno. L'emulatore di Firebase pero' e' HTTP, gira
  sul PC di chi sviluppa e non esce dalla macchina.

  Quindi l'eccezione c'e', ma e' **larga quanto serve e non un millimetro di piu'**: solo i tre
  indirizzi con cui un dispositivo raggiunge il proprio computer, e solo in debug. Questo file non
  esiste nella release, dove resta il divieto secco.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <!-- Il PC visto dall'emulatore Android. -->
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
